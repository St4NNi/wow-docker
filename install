#!/usr/bin/env bash
set -euo pipefail

project_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
bin_dir="$HOME/.local/bin"
applications_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
config_file="${WOW_DOCKER_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/wow-docker/config}"
desktop_enabled=true
declare -A options=()

usage() {
    cat <<'HELP'
Usage: ./install [options]
  --bin-dir DIR          Program directory (default: ~/.local/bin)
  --applications-dir DIR Menu entry directory (default: XDG applications)
  --config-file FILE     Settings file (default: ~/.config/wow-docker/config)
  --data-dir DIR         Persistent Wine, Battle.net and game directory
  --image NAME           Local Docker image
  --display DRIVER       auto, wayland or x11
  --gpu DRIVER           auto, nvidia, amd, intel or mesa
  --memory LIMIT         Container memory limit
  --cpus COUNT           Container CPU limit
  --no-desktop           Install only the command and settings
  --help                 Show this help
Existing settings are preserved. Edit the settings file to change them later.
HELP
}
while (( $# )); do
    case "$1" in
        --help) usage; exit ;;
        --no-desktop) desktop_enabled=false; shift ;;
        --bin-dir) bin_dir=${2:?Missing program directory}; shift 2 ;;
        --applications-dir) applications_dir=${2:?Missing menu directory}; shift 2 ;;
        --config-file) config_file=${2:?Missing settings file}; shift 2 ;;
        --data-dir) options[WOW_DOCKER_DATA_DIR]=${2:?Missing data directory}; shift 2 ;;
        --image) options[WOW_DOCKER_IMAGE]=${2:?Missing image}; shift 2 ;;
        --display) options[WOW_DOCKER_DISPLAY]=${2:?Missing display driver}; shift 2 ;;
        --gpu) options[WOW_DOCKER_GPU]=${2:?Missing GPU driver}; shift 2 ;;
        --memory) options[WOW_DOCKER_MEMORY]=${2:?Missing memory limit}; shift 2 ;;
        --cpus) options[WOW_DOCKER_CPUS]=${2:?Missing CPU limit}; shift 2 ;;
        *) printf 'Unknown option: %s\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
done

case "$(uname -s):$(uname -m)" in
    Linux:x86_64|Linux:amd64) ;;
    *) printf 'This installer requires x86-64 Linux.\n' >&2; exit 1 ;;
esac

bin_dir=$(realpath -m -- "$bin_dir")
applications_dir=$(realpath -m -- "$applications_dir")
config_file=$(realpath -m -- "$config_file")
program="$bin_dir/wow-docker"
desktop="$applications_dir/wow-docker.desktop"
if [[ "$config_file" == "$program" || "$config_file" == "$desktop" ]]; then
    printf 'Settings, program and menu paths must be different.\n' >&2
    exit 1
fi
config_exists=false
if [[ -e "$config_file" || -L "$config_file" ]]; then
    [[ -f "$config_file" ]] || { printf 'Settings path is not a file.\n' >&2; exit 1; }
    config_exists=true
    # shellcheck source=/dev/null
    source "$config_file"
fi

if [[ -n ${options[WOW_DOCKER_DATA_DIR]+set} ]]; then
    options[WOW_DOCKER_DATA_DIR]=$(realpath -m -- "${options[WOW_DOCKER_DATA_DIR]}")
fi
declare -A settings=(
    [WOW_DOCKER_DATA_DIR]="${XDG_DATA_HOME:-$HOME/.local/share}/wow-docker"
    [WOW_DOCKER_IMAGE]=wow-docker:local
    [WOW_DOCKER_DISPLAY]=auto
    [WOW_DOCKER_GPU]=auto
    [WOW_DOCKER_MEMORY]=12g
    [WOW_DOCKER_CPUS]=''
    [WOW_DOCKER_CONTAINER]=''
)
variables=(WOW_DOCKER_DATA_DIR WOW_DOCKER_IMAGE WOW_DOCKER_DISPLAY WOW_DOCKER_GPU
    WOW_DOCKER_MEMORY WOW_DOCKER_CPUS WOW_DOCKER_CONTAINER)
for variable in "${variables[@]}"; do
    settings[$variable]=${!variable:-${settings[$variable]}}
    if [[ -n ${options[$variable]+set} ]]; then
        if [[ "$config_exists" == true && "${options[$variable]}" != "${settings[$variable]}" ]]; then
            printf 'Existing settings differ. Edit %s or choose another --config-file.\n' "$config_file" >&2
            exit 1
        fi
        settings[$variable]=${options[$variable]}
    fi
done
settings[WOW_DOCKER_DATA_DIR]=$(realpath -m -- "${settings[WOW_DOCKER_DATA_DIR]}")
case "${settings[WOW_DOCKER_DISPLAY]}" in auto|wayland|x11) ;; *) printf 'Display must be auto, wayland or x11.\n' >&2; exit 1 ;; esac
case "${settings[WOW_DOCKER_GPU]}" in auto|nvidia|amd|intel|mesa) ;; *) printf 'GPU must be auto, nvidia, amd, intel or mesa.\n' >&2; exit 1 ;; esac
targets=("$program")
[[ "$desktop_enabled" == false ]] || targets+=("$desktop")
for target in "${targets[@]}"; do
    if [[ -e "$target" || -L "$target" ]]; then
        if [[ -L "$target" || ! -f "$target" || "$(sed -n '2p' "$target")" != '# Installed by wow-docker.' ]]; then
            printf 'Refusing to replace an unmanaged file: %s\n' "$target" >&2
            exit 1
        fi
    fi
done

docker info --format '{{.ServerVersion}}' >/dev/null
if ! docker image inspect "${settings[WOW_DOCKER_IMAGE]}" >/dev/null 2>&1; then
    WOW_DOCKER_IMAGE="${settings[WOW_DOCKER_IMAGE]}" WOW_DOCKER_CONFIG="$config_file" "$project_dir/build"
fi
mkdir -p "$bin_dir"
[[ "$desktop_enabled" == false ]] || mkdir -p "$applications_dir"
if [[ ! -d "$(dirname -- "$config_file")" ]]; then
    (umask 077; mkdir -p -- "$(dirname -- "$config_file")")
fi
program_temp=''
desktop_temp=''
config_temp=''
cleanup() {
    for temporary in "$program_temp" "$desktop_temp" "$config_temp"; do
        [[ -z "$temporary" || ! -e "$temporary" ]] || rm -- "$temporary"
    done
}
trap cleanup EXIT
if [[ "$config_exists" == false ]]; then
    config_temp=$(mktemp "$(dirname -- "$config_file")/.wow-docker.XXXXXX")
    {
        printf '# WoW Docker settings. Existing environment values take precedence.\n'
        for variable in "${variables[@]}"; do
            printf 'if [[ -z %s ]]; then\n    %s=%q\nfi\n' "\${$variable:-}" "$variable" "${settings[$variable]}"
        done
    } > "$config_temp"
    chmod 600 "$config_temp"
    mv -- "$config_temp" "$config_file"
fi
program_temp=$(mktemp "$bin_dir/.wow-docker.XXXXXX")
{
    printf '#!/usr/bin/env bash\n# Installed by wow-docker.\n'
    printf 'if [[ -z %s ]]; then\n    WOW_DOCKER_CONFIG=%q\nfi\n' "\${WOW_DOCKER_CONFIG:-}" "$config_file"
    tail -n +2 "$project_dir/run"
} > "$program_temp"
chmod 755 "$program_temp"

desktop_string() {
    local value=$1
    value=${value//\\/\\\\}
    value=${value//$'\n'/\\n}
    value=${value//$'\t'/\\t}
    value=${value//$'\r'/\\r}
    printf '%s' "$value"
}
desktop_quote() {
    local value=$1
    value=${value//\\/\\\\}
    value=${value//\"/\\\"}
    value=${value//\$/\\\$}
    value=${value//$'\x60'/\\$'\x60'}
    value=${value//%/%%}
    printf '"%s"' "$(desktop_string "$value")"
}
if [[ "$desktop_enabled" == true ]]; then
    desktop_temp=$(mktemp --suffix=.desktop "$applications_dir/.wow-docker.XXXXXX")
    {
        printf '[Desktop Entry]\n# Installed by wow-docker.\nType=Application\nName=WoW Docker\n'
        printf 'Comment=Run Battle.net and World of Warcraft in Docker\n'
        printf 'Exec=%s -- %s\n' "env bash" "$(desktop_quote "$program")"
        printf 'TryExec=%s\n' "$(desktop_string "$program")"
        printf 'Icon=applications-games\nCategories=Game;\nTerminal=false\nStartupNotify=false\nSingleMainWindow=true\n'
    } > "$desktop_temp"
    if command -v desktop-file-validate >/dev/null; then
        desktop-file-validate "$desktop_temp"
    fi
    chmod 644 "$desktop_temp"
fi
mv -- "$program_temp" "$program"
if [[ "$desktop_enabled" == true ]]; then
    mv -- "$desktop_temp" "$desktop"
    if command -v update-desktop-database >/dev/null; then
        update-desktop-database "$applications_dir"
    fi
fi
printf 'Program: %s\nSettings: %s\nData: %s\n' "$program" "$config_file" "${settings[WOW_DOCKER_DATA_DIR]}"
[[ "$desktop_enabled" == false ]] || printf 'Menu entry: %s\n' "$desktop"
